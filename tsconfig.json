{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022"],
        "outDir": "out",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "sourceMap": true,
        "declaration": false,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["mocha", "node"]
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules", "dist", "out", "out-test"]
}
